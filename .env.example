# Copy to .env and uncomment what you need. Every value is optional.

# SQLite database path (default: ./review-mcp.db, relative to the working dir).
# REVIEW_MCP_DB_PATH=/absolute/path/to/review.db

# Server logging (stderr only): level debug|info|warn|error, format json|human.
MCP_LOG_LEVEL=info
MCP_LOG_FORMAT=json
# Optional correlation id included in every log record.
MCP_TRACE_ID=
