{
  "name": "review-mcp-server",
  "version": "0.1.0",
  "description": "Local review context for CAD inspection: persist entity names and notes in SQLite and query metadata by entity, text, or hashtag.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "review-mcp": "dist/src/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "tsx --test test/*.test.ts",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26",
    "tsx": "^4",
    "typescript": "^5"
  }
}
